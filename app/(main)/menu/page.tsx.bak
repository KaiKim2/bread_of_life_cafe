"use client";

import { useEffect, useState } from "react";
import { verses } from "@/data/verses";

export default function MenuPage() {
  const [loaded, setLoaded] = useState(false);
  const [name, setName] = useState("Friend");
  const [need, setNeed] = useState("");
  const [meal, setMeal] = useState<{
    reference: string;
    scripture: string;
    reflection: string;
    challenge: string;
  } | null>(null);

  useEffect(() => {
    const savedName =
      localStorage.getItem("bread_name") || "Friend";

    const savedNeed =
      localStorage.getItem("bread_need") || "Need Peace";

    setName(savedName);
    setNeed(savedNeed);

    const choices =
      verses[savedNeed as keyof typeof verses] || [];

    if (choices.length > 0) {
      const random =
        choices[Math.floor(Math.random() * choices.length)];

      setMeal(random);
    }

    setLoaded(true);
  }, []);

  if (!loaded) return null;

  return (
    <main
      style={{
        minHeight: "100vh",
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        background:
          "linear-gradient(135deg,#fdf9f2 0%,#f6eddc 100%)",
        padding: "40px",
      }}
    >
      <div
        style={{
          width: "100%",
          maxWidth: "850px",
          background: "white",
          borderRadius: "30px",
          padding: "60px",
          boxShadow: "0 25px 80px rgba(0,0,0,.08)",
          textAlign: "center",
        }}
      >
        <div
          style={{
            fontSize: "70px",
            marginBottom: "20px",
          }}
        >
          🍞
        </div>

        <h1
          style={{
            fontSize: "3rem",
            marginBottom: "10px",
            color: "#2d2115",
          }}
        >
          The Shepherd's Table
        </h1>

        <p
          style={{
            color: "#78614b",
            fontSize: "1.15rem",
          }}
        >
          Welcome back,
          <strong> {name}</strong>.
        </p>

        <div
          style={{
            marginTop: "45px",
            marginBottom: "45px",
          }}
        >
          <div
            style={{
              fontSize: "14px",
              color: "#9b7b56",
              textTransform: "uppercase",
              letterSpacing: "2px",
              marginBottom: "10px",
            }}
          >
            Today's Meal
          </div>

          <h2
            style={{
              fontSize: "2rem",
              color: "#b88433",
              marginBottom: "30px",
            }}
          >
            {need}
          </h2>

          {meal ? (
            <>
              <h3
                style={{
                  fontSize: "1.35rem",
                  marginBottom: "20px",
                  color: "#3f2d1d",
                }}
              >
                {meal.reference}
              </h3>

              <blockquote
                style={{
                  fontSize: "1.25rem",
                  lineHeight: 1.9,
                  fontStyle: "italic",
                  color: "#56412f",
                  maxWidth: "700px",
                  margin: "0 auto",
                }}
              >
                "{meal.scripture}"
              </blockquote>
            </>
          ) : (
            <p
              style={{
                color: "#888",
                fontSize: "1.1rem",
              }}
            >
              No verses have been added for this category yet.
            </p>
          )}
        </div>

        <button
          style={{
            padding: "18px 40px",
            border: "none",
            borderRadius: "18px",
            cursor: "pointer",
            background:
              "linear-gradient(135deg,#b88433,#e5c06b)",
            color: "white",
            fontWeight: 700,
            fontSize: "18px",
          }}
        >
          🍽 Serve Another Meal
        </button>
      </div>
    </main>
  );
}
